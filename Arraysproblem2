import java.util.Arrays; // nag i-import ng arrays

public class ArraysProblem2 { // pangalan ng klase
    public static void main (String [] args){ // simula ng program

        // gumagawa ng 2D string array "seats" na may 2 or 3 rows
        String[][] seats = {
                {"Alice", "Bob", "Charlie"}, // Row 1 (index 0): tatlong upuan
                {"David", "Emma", "Frank"} // Row 2 (index 1): tatlong upuan
        }; // pagtatapos ng deklarasyon

        System.out.println(seats[1][2]); // kopya ng linya
        // palitan si bob ng vacant
        seats[0][1] = "Vacant"; //[0][1] walang laman

        // i-print na yung buong seating arrangement sa isang linya gamit si Arrays.deepToString(0
        System.out.println(Arrays.deepToString(seats));




    }
}
